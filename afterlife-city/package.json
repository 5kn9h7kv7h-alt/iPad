{
  "name": "afterlife-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFTERLIFE CITY — AI coastal city observation simulation",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server": "node server/index.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "test:e2e:a": "E2E_PART=a node tests/e2e/smoke.mjs",
    "test:e2e:b": "E2E_PART=b node tests/e2e/smoke.mjs",
    "lookdev": "node tests/e2e/lookdev.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "meshoptimizer": "^1.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
