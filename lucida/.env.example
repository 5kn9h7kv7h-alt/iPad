# すべて任意。未設定でもローカル保存 + ルールベース生成で動作します。
# 注意: VITE_ 付きの値はブラウザに公開されます。Anthropic等のAPIキーは絶対にここへ入れないでください。
# AIキーはサーバー側（Supabase Edge Function 等）にだけ置き、ここにはそのURLを指定します。

# Supabase を使う場合（anon key は公開前提の鍵。データ保護は RLS で行う）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 保存先を Supabase にする場合だけ指定（既定はこの端末内の IndexedDB）。指定するとサインイン画面が出ます
VITE_LUCIDA_BACKEND=

# AI を中継するサーバー側エンドポイント（Supabase Edge Function の URL。キーはそちらで保持）
# 発見の生成:   https://<project>.supabase.co/functions/v1/generate-discovery
VITE_LUCIDA_AI_ENDPOINT=
# 実験の分析:   https://<project>.supabase.co/functions/v1/analyze-experiment
VITE_LUCIDA_ANALYZE_ENDPOINT=
